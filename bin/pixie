#!/usr/bin/env python3
"""pixie — the tool-capable operational core assistant via raw completion.

No arguments: launches the interactive chat assistant (bubbled TUI, streaming).
With a prompt: one-shot answer mode (existing behavior): pixie [-v] "prompt".
"""
from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
import threading
import urllib.parse
import urllib.request
import time
from pathlib import Path

_BIN_DIR = Path(__file__).resolve().parent
if str(_BIN_DIR) not in sys.path:
    sys.path.insert(0, str(_BIN_DIR))
import pixie_mind as mind  # noqa: E402

API_URL = f"http://127.0.0.1:{os.environ.get('PIXIE_LLM_PORT', '8080')}/completion"


def _system_prompt() -> str:
    names = ", ".join(mind.spell_names()) or "(none)"
    mem = mind.load_memory_inject()
    return f"""You are Pixie, a sharp, helpful, and concise AI assistant running locally.
You have access to local system tools. You can choose to call a tool by outputting a clean JSON object containing "name" and "arguments" fields.
Your primary AI runtime is the menagerie: each app (pixie, ask, magpie, imp, kur) owns its own local llama-server instance — pixie's lives on port 8080.

Available tools:
1. execute_bash: {{"name": "execute_bash", "arguments": {{"command": "string"}}}}
2. read_local_file: {{"name": "read_local_file", "arguments": {{"path": "string", "start_line": int, "end_line": int}}}}
3. manage_systemd_service: {{"name": "manage_systemd_service", "arguments": {{"service_name": "string", "action": "status|restart|logs"}}}}
4. check_mail: {{"name": "check_mail", "arguments": {{"sync": bool, "box": "unread|read|trash"}}}}
5. house: {{"name": "house", "arguments": {{"spell": "string", "args": ["string"]}}}}
6. remember: {{"name": "remember", "arguments": {{"fact": "string"}}}}

Known house spells: {names}. Prefer house over inventing bash. execute_bash already sees ~/bin and rewrites those names.

House memory:
{mem}

If you need to use a tool to answer the user, output ONLY the JSON object for that tool call. No other text.
If you have the final answer or do not need a tool, output a clear, friendly conversational response."""

# --- Core Tool Executions ---

HOME = Path.home()

# Paths we refuse to touch even under $HOME
BLOCKED_PREFIXES = (
    HOME / ".ssh",
    HOME / ".gnupg",
    HOME / ".grok" / "credentials",
)

# Tools that mutate the system and must be explicitly approved by the user
# before they run. In one-shot mode (no confirmation available) they are denied.
_CONFIRM_TOOLS = ("execute_bash",)

_SERVICE_RE = re.compile(r"^[A-Za-z0-9@._:-]+$")


class _Confirm:
    """Cross-thread confirmation gate: the worker thread blocks in ask() until
    the UI thread calls respond() with the user's y/n answer."""

    def __init__(self) -> None:
        self._cond = threading.Condition()
        self.pending: tuple | None = None
        self._answer: bool | None = None

    def ask(self, fname: str, fargs: dict) -> bool:
        with self._cond:
            self.pending = (fname, fargs)
            self._answer = None
            self._cond.notify_all()
            while self._answer is None:
                self._cond.wait(0.2)
            return self._answer

    def respond(self, answer: bool) -> None:
        with self._cond:
            if self.pending is not None:
                self._answer = answer
                self.pending = None
                self._cond.notify_all()


def run_bash_command(command: str) -> dict:
    """Run a command as an argument vector (no shell). Spell names rewrite
    to house bins; PATH includes ~/bin."""
    if not isinstance(command, str) or not command.strip():
        return {"error": "empty command"}
    try:
        argv = mind.rewrite_bash(command)
    except ValueError as e:
        return {"error": f"could not parse command: {e}"}
    if not argv:
        return {"error": "empty command"}
    head = Path(argv[0]).name
    if head in ("systemctl", "journalctl") and "--no-pager" not in argv:
        argv.insert(1, "--no-pager")
    return mind.run_argv(argv)

def read_local_file(path: str, start_line: int | None = None, end_line: int | None = None) -> dict:
    try:
        expanded_path = os.path.expanduser(path)
        if not os.path.exists(expanded_path):
            return {"error": f"File not found: {path}"}
        with open(expanded_path, 'r', encoding='utf-8', errors='replace') as f:
            lines = f.readlines()
        start = max(0, (start_line - 1)) if start_line else 0
        end = min(len(lines), end_line) if end_line else len(lines)
        return {
            "path": path,
            "content": "".join(lines[start:end]),
            "bounded_from": start + 1,
            "bounded_to": end
        }
    except Exception as e:
        return {"error": str(e)}

def manage_systemd_service(service_name: str, action: str) -> dict:
    if not isinstance(service_name, str) or not _SERVICE_RE.match(service_name):
        return {"error": f"invalid service name: {service_name!r}"}
    if action not in ("status", "restart", "logs"):
        return {"error": f"Invalid action: {action}"}
    is_user = service_name in ["menagerie.service", "menagerie", "kur"] or "--user" in sys.argv
    scope_flag = ["--user"] if is_user else []

    if action == "status":
        cmd = ["systemctl", *scope_flag, "status", service_name, "--no-pager"]
    elif action == "restart":
        cmd = ["systemctl", *scope_flag, "restart", service_name]
    else:
        cmd = ["journalctl", *scope_flag, "-u", service_name, "-n", "15", "--no-pager"]

    res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    
    # FILTER EXHAUSTIVE LOGS: Keep context clean and lightweight for the LLM turn
    stdout_payload = res.stdout.strip()
    if action == "status" and res.returncode == 0:
        # Extract only the critical unit state definitions, dropping the journal tail
        filtered_lines = [
            line for line in stdout_payload.splitlines() 
            if any(k in line for k in ["Loaded:", "Active:", "Main PID:", "Tasks:", "Memory:"])
        ]
        stdout_payload = "\n".join(filtered_lines)

    return {
        "service": service_name, 
        "action": action, 
        "stdout": stdout_payload, 
        "stderr": res.stderr.strip()
    }

def _assert_allowed(path: str) -> Path:
    """Resolve and refuse paths outside $HOME or into sensitive dirs."""
    p = Path(os.path.expanduser(path)).resolve()
    try:
        p.relative_to(HOME.resolve())
    except ValueError as e:
        raise PermissionError(f"refusing path outside home ({HOME}): {path}") from e
    for b in BLOCKED_PREFIXES:
        try:
            p.relative_to(b.resolve())
            raise PermissionError(f"refusing sensitive path: {path}")
        except ValueError:
            pass
    return p

def write_local_file(path: str, content: str) -> dict:
    try:
        p = _assert_allowed(path)
        d = p.parent
        if not d.is_dir():
            d.mkdir(parents=True, exist_ok=True)
        with open(p, "w", encoding="utf-8") as f:
            f.write(content)
        return {"path": str(p), "written": True, "bytes": len(content)}
    except PermissionError as e:
        return {"error": str(e)}
    except Exception as e:
        return {"error": str(e)}

def web_research(query: str, max_results: int = 5) -> dict:
    """Search via Magpie (ddgr → DDG HTML → Marginalia)."""
    return mind.search_web(query, max_results)


def fetch_web_page(url: str, max_chars: int = 4000) -> dict:
    """Read a URL through Magpie browse --dump."""
    return mind.read_page(url, max_chars)


# --- Mail (via goblin: aerc IMAP → ~/.cache/goblin/mail/{unread,read,trash}/*.txt) ---

GOBLIN = Path.home() / "bin" / "goblin"


def _run_goblin(argv: list[str], timeout: int = 120) -> str:
    """Run the goblin CLI; return stdout+stderr text for the agent."""
    if not GOBLIN.is_file():
        return f"error: goblin not found at {GOBLIN}"
    try:
        proc = subprocess.run(
            [str(GOBLIN), *argv],
            capture_output=True,
            text=True,
            timeout=timeout,
            env={**os.environ, "PATH": f"{Path.home() / 'bin'}:{os.environ.get('PATH', '')}"},
        )
    except subprocess.TimeoutExpired:
        return f"error: goblin timed out after {timeout}s (IMAP slow or unreachable?)"
    except OSError as e:
        return f"error: could not run goblin: {e}"
    out = (proc.stdout or "").strip()
    err = (proc.stderr or "").strip()
    parts = [out] if out else []
    if err:
        parts.append(f"[log]\n{err}")
    if proc.returncode != 0:
        parts.append(f"(exit {proc.returncode})")
    return "\n".join(parts) if parts else "(no output)"


def check_mail(sync: bool = True, box: str = "unread", max_messages: int = 20) -> dict:
    """Sync mail via goblin and return a digest pixie can summarize.

    sync=True downloads new mail from the IMAP account first. box may be
    unread|read|trash; the digest (full contents for summarization) is
    only built for unread.
    """
    box = (box or "unread").strip().lower()
    if box not in ("unread", "read", "trash"):
        return {"error": "box must be unread, read, or trash"}
    result: dict = {"box": box}
    if sync:
        result["sync"] = _run_goblin(["sync"], timeout=180)
    listing = _run_goblin(["list", box, "--plain"], timeout=60)
    result["listing"] = listing
    subjects = []
    for line in listing.splitlines():
        fields = line.split("\t")
        if len(fields) >= 4 and fields[3].startswith("subject="):
            subjects.append(fields[3][len("subject="):])
    result["count"] = len(subjects)
    result["subjects"] = subjects
    if box == "unread":
        limit = max(1, min(int(max_messages or 20), 50))
        result["digest"] = _run_goblin(["bundle", "--limit", str(limit)], timeout=60)
    else:
        result["digest"] = "(no digest for read/trash — use the listing)"
    return result

_KNOWN_TOOLS = ["execute_bash", "read_local_file", "manage_systemd_service",
                "write_local_file", "web_research", "fetch_web_page", "check_mail",
                "house", "remember", "wiki", "search_house", "write_plan"]

_TOOL_ALIASES = {
    "create_file": "write_local_file", "create": "write_local_file",
    "write_file": "write_local_file", "write": "write_local_file",
    "run_command": "execute_bash", "run": "execute_bash",
    "execute_command": "execute_bash", "shell": "execute_bash",
    "bash": "execute_bash", "run_bash": "execute_bash",
    "read_file": "read_local_file", "read": "read_local_file",
    "search_web": "web_research", "web_search": "web_research",
    "fetch_url": "fetch_web_page", "open_url": "fetch_web_page",
    "read_page": "fetch_web_page", "wikipedia": "wiki", "wiki_search": "wiki",
    "grep_house": "search_house", "search_docs": "search_house",
    "save_plan": "write_plan", "plan": "write_plan",
    "systemctl": "manage_systemd_service",
    "check_email": "check_mail", "mail": "check_mail", "email": "check_mail",
    "get_mail": "check_mail", "list_mail": "check_mail", "read_mail": "check_mail",
    "inbox": "check_mail",
    "file_create": "write_local_file", "create_file": "write_local_file",
    "mkfile": "write_local_file", "writefile": "write_local_file",
    "write_content": "write_local_file", "write_to_file": "write_local_file",
    "code_editor": "write_local_file", "text_editor": "write_local_file",
    "apply_patch": "write_local_file", "file_editor": "write_local_file",
    "execute_script": "execute_bash", "run_terminal_command": "execute_bash",
    "shell_command": "execute_bash", "terminal": "execute_bash",
    "run_script": "execute_bash", "run_python": "execute_bash",
    "cast": "house", "spell": "house", "run_spell": "house", "invoke": "house",
    "memory": "remember", "note": "remember", "memorize": "remember",
    "save_memory": "remember",
}

def _norm_args(fname: str, fargs: dict) -> dict:
    """Accept common alias argument names from small models."""
    if fname == "write_local_file":
        path = next((fargs[k] for k in ("path", "file_path", "filename", "file", "filepath") if k in fargs), fargs.get("path", ""))
        content = next((fargs[k] for k in ("content", "file_text", "text", "new_string", "file_content") if k in fargs), "")
        return {"path": str(path), "content": str(content)}
    if fname == "execute_bash":
        cmd = next((fargs[k] for k in ("command", "cmd", "script", "command_string", "bash_command") if k in fargs), fargs.get("command", ""))
        return {"command": str(cmd)}
    if fname == "read_local_file":
        path = next((fargs[k] for k in ("path", "file_path", "filename", "filepath") if k in fargs), fargs.get("path", ""))
        return {"path": str(path), "start_line": fargs.get("start_line"), "end_line": fargs.get("end_line")}
    if fname == "web_research":
        return {"query": str(fargs.get("query", "")), "max_results": int(fargs.get("max_results", 5))}
    if fname == "check_mail":
        sync = fargs.get("sync", fargs.get("sync_mail", fargs.get("pull", True)))
        box = str(fargs.get("box", fargs.get("folder", fargs.get("mailbox", "unread"))) or "unread")
        limit = fargs.get("max_messages", fargs.get("limit", fargs.get("max_results", 20)))
        return {"sync": sync, "box": box, "max_messages": int(limit or 20)}
    if fname == "house":
        spell = next((fargs[k] for k in ("spell", "name", "command", "bin") if k in fargs), "")
        args = fargs.get("args", fargs.get("arguments", fargs.get("extra", [])))
        if isinstance(args, str):
            try:
                args = shlex.split(args)
            except ValueError:
                args = [args]
        if not isinstance(args, list):
            args = [str(args)] if args is not None else []
        spell = str(spell).strip()
        if " " in spell and not args:
            try:
                parts = shlex.split(spell)
            except ValueError:
                parts = spell.split()
            if parts:
                spell, args = parts[0], parts[1:]
        return {"spell": spell, "args": [str(a) for a in args]}
    if fname == "remember":
        fact = next((fargs[k] for k in ("fact", "text", "note", "memory", "content") if k in fargs), "")
        return {"fact": str(fact)}
    if fname == "wiki":
        q = next((fargs[k] for k in ("query", "q", "search", "topic") if k in fargs), "")
        n = fargs.get("max_results", fargs.get("limit", 5))
        return {"query": str(q), "max_results": int(n or 5)}
    if fname == "search_house":
        q = next((fargs[k] for k in ("query", "q", "search", "pattern") if k in fargs), "")
        return {"query": str(q)}
    if fname == "write_plan":
        return {
            "goal": str(fargs.get("goal", fargs.get("title", ""))),
            "steps": fargs.get("steps", fargs.get("plan", [])),
            "files": fargs.get("files", fargs.get("paths", [])),
            "risks": fargs.get("risks", fargs.get("tradeoffs", [])),
            "verify": str(fargs.get("verify", fargs.get("check", ""))),
        }
    return fargs

def run_tool(fname: str, fargs: dict, confirm=None, session_id: str = "") -> dict:
    """Execute a single tool call (mirrors ask_pixie dispatch).

    `confirm` is an optional callable(fname, fargs) -> bool used to gate
    mutating tools (see _CONFIRM_TOOLS). When it is None and a tool requires
    confirmation, the tool is denied (one-shot / non-interactive safety).
    """
    fname = _TOOL_ALIASES.get(fname, fname)
    if fname not in _KNOWN_TOOLS:
        return {"error": f"Unknown tool '{fname}'. Valid tools: {', '.join(_KNOWN_TOOLS)}"}
    if not isinstance(fargs, dict):
        fargs = {}
    fargs = _norm_args(fname, fargs)
    if fname in _CONFIRM_TOOLS:
        if confirm is None:
            return {"error": (f"'{fname}' needs approval and none is available here; "
                              "run `pixie` (interactive chat) to review and approve actions.")}
        if not confirm(fname, fargs):
            return {"error": f"'{fname}' was not approved by the user."}
    if fname == "execute_bash":
        return run_bash_command(fargs.get('command', ''))
    if fname == "read_local_file":
        return read_local_file(fargs.get('path', ''), fargs.get('start_line'), fargs.get('end_line'))
    if fname == "manage_systemd_service":
        s_name = fargs.get('service_name', 'menagerie.service')
        if s_name in ["your_user_name", "your_user_service", "default", "user-environment"]:
            s_name = "menagerie.service"
        return manage_systemd_service(s_name, fargs.get('action', 'status'))
    if fname == "write_local_file":
        return write_local_file(fargs.get('path', ''), fargs.get('content', ''))
    if fname == "web_research":
        r = web_research(fargs.get('query', ''), int(fargs.get('max_results', 5)))
        if session_id:
            for item in r.get("results") or []:
                mind.note_source(session_id, item.get("url", ""), item.get("title", ""))
        return r
    if fname == "fetch_web_page":
        r = fetch_web_page(fargs.get('url', ''), int(fargs.get('max_chars', 6000)))
        if session_id:
            mind.note_source(session_id, r.get("url") or fargs.get("url", ""), r.get("title", ""))
        return r
    if fname == "wiki":
        r = mind.wiki(fargs.get("query", ""), int(fargs.get("max_results", 5)))
        if session_id:
            for item in r.get("results") or []:
                mind.note_source(session_id, item.get("url", ""), item.get("title", ""))
        return r
    if fname == "search_house":
        return mind.search_house(fargs.get("query", ""))
    if fname == "write_plan":
        return mind.write_plan(
            fargs.get("goal", ""),
            steps=fargs.get("steps"),
            files=fargs.get("files"),
            risks=fargs.get("risks"),
            verify=fargs.get("verify", ""),
            session_id=session_id,
        )
    if fname == "check_mail":
        return check_mail(fargs.get('sync', True), fargs.get('box', 'unread'), fargs.get('max_messages', 20))
    if fname == "house":
        spell = str(fargs.get("spell") or "")
        extra = list(fargs.get("args") or [])
        r = mind.resolve_spell(spell, extra)
        if "error" in r:
            return r
        if r.get("confirm"):
            if confirm is None:
                return {"error": (f"'house {spell}' needs approval and none is available here; "
                                  "run `pixie` (interactive chat) to review and approve actions.")}
            if not confirm(fname, {"spell": spell, "args": extra}):
                return {"error": f"'house {spell}' was not approved by the user."}
        return mind.run_argv(r["argv"])
    if fname == "remember":
        return mind.remember(fargs.get("fact", ""))
    return {"error": f"Unknown function mapping: {fname}"}

_TOOL_RESULT_CAP = 1200
_TOOL_ROUND_CAP = 4000

def tool_payload(results: list) -> str:
    """Serialize tool results for the model, capped to keep the context small.

    Big results (mail digests, file reads, ls -R) would otherwise blow the
    LLM context in one round; the TUI display is unaffected (tool_body).
    """
    parts = []
    used = 0
    for item in results:
        s = json.dumps(item, ensure_ascii=False)
        if len(s) > _TOOL_RESULT_CAP:
            s = s[:_TOOL_RESULT_CAP] + f"… [truncated: was {len(s)} chars]"
        if used + len(s) > _TOOL_ROUND_CAP:
            break
        parts.append(s)
        used += len(s)
    return "[" + ", ".join(parts) + "]"

def _drop_oldest(msgs: list, keep_ratio: float = 0.5) -> bool:
    """Drop oldest tool payloads first so a retry fits the context."""
    return mind.drop_oldest(msgs, keep_ratio)

def extract_tool_call(text: str):
    """Find a JSON object with name+arguments anywhere in text (handles
    narrated/```json``` tool calls). Returns (obj, start, end) or None."""
    calls = extract_all_tool_calls(text, limit=1)
    return calls[0] if calls else None

def extract_all_tool_calls(text: str, limit: int = 8) -> list:
    """Extract tool calls from JSON, fences, XML, or mixed prose."""
    return mind.extract_tool_calls(text, limit=limit)
# --- Raw Completion Communications ---

def llm_up(verbose: bool = False) -> bool:
    """True when the local llama.cpp on API_URL answers /health.

    200 = loaded; 503 = server up, model asleep (sleep-idle) — either is
    usable, the first request wakes the model.
    """
    base = API_URL.rsplit("/", 1)[0]
    try:
        req = urllib.request.Request(base + "/health")
        with urllib.request.urlopen(req, timeout=2) as resp:
            return resp.status in (200, 503)
    except Exception:
        return False


def ensure_llm_up(quiet: bool = True) -> bool:
    """Summon pixie's own critter (menagerie ensure pixie, port 8080).

    Returns True once the server reports healthy (model may still be
    loading — llama.cpp answers 200 with a model still warming up).
    """
    import subprocess
    try:
        subprocess.run(
            [str(Path.home() / "bin" / "menagerie"), "ensure", "pixie"],
            capture_output=True, timeout=240)
    except Exception:
        return llm_up()
    for _ in range(60):
        if llm_up():
            return True
        time.sleep(1)
    return llm_up()


def unload_qwen() -> None:
    """Stop pixie's own llama-server instance when the chat quits."""
    import subprocess
    try:
        subprocess.run(
            [str(Path.home() / "bin" / "menagerie"), "stop", "pixie"],
            capture_output=True, timeout=30)
    except Exception:
        pass


def query_raw_llm(raw_prompt: str) -> str:
    body = {
        "prompt": raw_prompt,
        "temperature": 0.2,
        "max_tokens": 768,
        "stream": False,
        "stop": ["<|im_end|>", "<|im_start|>"]
    }
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(body).encode('utf-8'),
        headers={'Content-Type': 'application/json'},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            data = json.loads(response.read().decode('utf-8'))
            return str(data['content']).strip()
    except Exception as e:
        return f"Communication error: {e}"

def ask_pixie(user_prompt: str, verbose: bool = False) -> str:
    os.environ["PIXIE_UNICODE"] = "1"
    os.environ["LANG"] = "en_US.UTF-8"
    mind.seed_memory()
    sid = "oneshot-" + time.strftime("%Y%m%d-%H%M%S")
    mind.append_session(sid, "user", user_prompt, rune="oneshot")

    raw_prompt = (
        "<|im_start|>system\n"
        f"{_system_prompt()}<|im_end|>\n"
        f"<|im_start|>user\n{user_prompt}<|im_end|>\n"
        "<|im_start|>assistant\n"
    )
    
    start_time = time.time()
    
    if sys.stderr.isatty():
        print("\033[90m✦ Intercepting intent... invoking offline engine...\033[0m", file=sys.stderr)
        
    first_response = query_raw_llm(raw_prompt)

    # Tool intercept logic
    func_name, func_args = None, {}
    if first_response.startswith('{') and '"name"' in first_response:
        try:
            tool_intent = json.loads(first_response)
            func_name = tool_intent.get('name')
            func_args = tool_intent.get('arguments', {})
        except json.JSONDecodeError:
            pass

    if func_name:
        result = run_tool(func_name, func_args)
        elapsed_time = time.time() - start_time
        
        if sys.stderr.isatty():
            try:
                print("\033[F\033[K", end="", file=sys.stderr)
                
                import fae_termart as art
                from fae_termart import Palette as P
                
                routing_line = f"Routing: {func_name} -> {json.dumps(func_args)}"
                if verbose:
                    telemetry_line = "Telemetry Expanded: View below"
                else:
                    telemetry_line = "Telemetry Hidden: Pass -v or --verbose to expand tool mirrors."
                
                tool_box_content = f"{routing_line}\n{telemetry_line}"
                
                fit = max(40, min(76, art.term_width() - 1))
                print(art.box(
                    tool_box_content,
                    title=f"Calling tools ─────── ✦ Thought for {elapsed_time:.2f}s",
                    accent=P.BLUSH,
                    body_style=(),
                    width=fit
                ), file=sys.stderr)
                
                if verbose:
                    print("\033[90m▼ [Pixie Tool Output Mirror Expanded] ──────────────────────────", file=sys.stderr)
                    if "stdout" in result and result["stdout"]:
                        print(result["stdout"], file=sys.stderr)
                    if "stderr" in result and result["stderr"]:
                        print(f"Error Channel: {result['stderr']}", file=sys.stderr)
                    if "error" in result:
                        print(f"Execution Error: {result['error']}", file=sys.stderr)
                    print("─────────────────────────────────────────────────────────────────\033[0m", file=sys.stderr)
            except Exception as le:
                print(f"\033[90m[Pixie Routing: {func_name} -> {json.dumps(func_args)}]\033[0m", file=sys.stderr)
            
        raw_prompt += (
            f"{first_response}<|im_end|>\n"
            f"<|im_start|>tool name={func_name}\n{json.dumps(result)}<|im_end|>\n"
            "<|im_start|>assistant\n"
        )
        
        final_response = query_raw_llm(raw_prompt)
        mind.append_session(
            sid, "tool", rune="oneshot",
            tool=func_name, args=func_args, result=result, raw=first_response,
        )
        mind.append_session(sid, "assistant", final_response, rune="oneshot")
        return final_response
        
    else:
        if sys.stderr.isatty():
            print("\033[F\033[K", end="", file=sys.stderr)

    mind.append_session(sid, "assistant", first_response, rune="oneshot")
    return first_response

_TOOL_LOG = os.path.expanduser("~/.cache/pixie/chat_tools.log")

def _log_tool(fname: str, fargs: dict, result: dict) -> None:
    try:
        os.makedirs(os.path.dirname(_TOOL_LOG), exist_ok=True)
        with open(_TOOL_LOG, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {fname} {json.dumps(fargs)[:160]} -> "
                    f"{json.dumps(result)[:120]}\n")
    except Exception:
        pass
# --- Interactive Chat (classic assistant) ---

def stream_completion(prompt: str, on_chunk, cancel: dict, err_sink=None) -> str:
    """Stream a completion; on_chunk(text) per token; cancel['flag'] aborts."""
    body = {
        "prompt": prompt,
        "temperature": 0.2,
        "max_tokens": 2048,
        "stream": True,
        "stop": ["<|im_end|>", "<|im_start|>"],
    }
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(body).encode('utf-8'),
        headers={'Content-Type': 'application/json'},
        method="POST",
    )
    full = []
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw in resp:
                if cancel["flag"]:
                    return "".join(full)
                line = raw.decode("utf-8", "replace").strip()
                if line.startswith("data:"):
                    payload = line[5:].strip()
                    if not payload:
                        continue
                    try:
                        d = json.loads(payload)
                    except json.JSONDecodeError:
                        continue
                    chunk = d.get("content", "")
                    if chunk:
                        full.append(chunk)
                        on_chunk(chunk)
    except Exception as e:
        if err_sink:
            err_sink(str(e))
    return "".join(full)

def chat_messages(chat: list, rune: dict, session_id: str = "") -> list:
    tools_block = "\n".join(
        f"{i}. {name}: {schema}" for i, (name, schema) in enumerate(rune.get("tools", []), 1)
    )
    extra = ""
    plan = mind.load_plan(session_id) if session_id else ""
    if plan:
        extra += f"\n\nActive plan:\n{plan}\n"
    srcs = mind.listed_sources(session_id) if session_id else []
    if srcs:
        extra += "\nSources gathered this session:\n" + "\n".join(
            f"- {s.get('title') or s.get('url')} {s.get('url')}" for s in srcs[:16]
        )
    sys_ctx = (f"You are running on the user's faeOS system.\n"
               f"Current working directory: {os.getcwd()}\n"
               f"Use real, existing paths (relative to the working directory or absolute).\n"
               f"{mind.spells_line()}\n\n"
               f"House memory:\n{mind.load_memory_inject()}\n"
               f"{extra}\n"
               f"{rune['prompt']}\n\n"
               f"Available tools in this mode:\n{tools_block}")
    msgs = [{"role": "system", "content": sys_ctx}]
    history = chat[-14:]
    last_tool = mind.last_tool_entry(history)
    n = len(history)
    for i, entry in enumerate(history):
        role, text, *rest = entry
        if role == "tool":
            if last_tool is not None and entry is last_tool:
                body = rest[0] if rest else text
                msgs.append({"role": "tool", "content": str(body)[:_TOOL_RESULT_CAP]})
            continue
        if role not in ("user", "assistant"):
            continue
        content = text
        if role == "user" and i == n - 1:
            content += ("\n\n(If you need a tool, your reply must be EXACTLY one JSON object "
                        "{\"name\": \"one of the available tools above\", \"arguments\": {...}} "
                        "— nothing else. "
                        "Otherwise reply conversationally with your pixie charm.)")
        msgs.append({"role": role, "content": content})
    return msgs

def _rune_tools(rune: dict) -> list:
    """OpenAI-style tools array from a rune's (name, schema-string) list."""
    out = []
    for name, schema in rune.get("tools") or []:
        props = {}
        try:
            raw = json.loads(schema) if isinstance(schema, str) else schema
        except json.JSONDecodeError:
            raw = {}
        if isinstance(raw, dict):
            for k, v in raw.items():
                t = str(v).strip().lower()
                if t in ("int", "integer"):
                    props[k] = {"type": "integer"}
                elif t in ("bool", "boolean"):
                    props[k] = {"type": "boolean"}
                else:
                    props[k] = {"type": "string"}
        out.append({
            "type": "function",
            "function": {
                "name": name,
                "parameters": {"type": "object", "properties": props},
            },
        })
    return out


def stream_chat(messages: list, on_chunk, cancel: dict, err_sink=None, tools=None) -> str:
    """Stream a chat completion (OpenAI-style /v1/chat/completions)."""
    body = {
        "messages": messages,
        "temperature": 0.2,
        "max_tokens": 2048,
        "stream": True,
    }
    if tools:
        body["tools"] = tools
        body["tool_choice"] = "auto"
    url = API_URL.replace("/completion", "/v1/chat/completions")
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode('utf-8'),
        headers={'Content-Type': 'application/json'},
        method="POST",
    )
    full = []
    acc_tools: dict[int, dict] = {}
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw in resp:
                if cancel["flag"]:
                    return "".join(full)
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if not payload or payload == "[DONE]":
                    continue
                try:
                    d = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                for ch in d.get("choices", []):
                    delta = ch.get("delta", {}) or {}
                    for tc in delta.get("tool_calls") or []:
                        idx = int(tc.get("index") or 0)
                        slot = acc_tools.setdefault(idx, {"name": "", "arguments": ""})
                        fn = tc.get("function") or {}
                        if fn.get("name"):
                            slot["name"] += fn["name"]
                        if fn.get("arguments"):
                            slot["arguments"] += fn["arguments"]
                    chunk = delta.get("content") or ""
                    if chunk:
                        full.append(chunk)
                        on_chunk(chunk)
    except Exception as e:
        if err_sink:
            err_sink(str(e))
    text = "".join(full)
    if acc_tools and not mind.extract_tool_calls(text, limit=1):
        parts = []
        for idx in sorted(acc_tools):
            slot = acc_tools[idx]
            try:
                args = json.loads(slot["arguments"]) if slot["arguments"] else {}
            except json.JSONDecodeError:
                args = {"command": slot["arguments"]}
            parts.append({"name": slot["name"], "arguments": args})
        if parts:
            synth = json.dumps(parts[0])
            if not text:
                on_chunk(synth)
            text = synth if not text else text + "\n" + synth
    return text

def build_prompt(chat: list[tuple[str, str]], rune: dict) -> str:
    parts = [f"<|im_start|>system\n{rune['prompt']}<|im_end|>"]
    for role, text, *_ in chat[-14:]:
        if role in ("user", "assistant"):
            parts.append(f"<|im_start|>{role}\n{text}<|im_end|>")
    parts.append("<|im_start|>assistant\n")
    return "\n".join(parts)
