def _wall_row(text: str, tw: int, art) -> str:
    body_w = max(1, tw - 4)
    vis = art.vis_len(text)
    if vis < body_w:
        text = text + " " * (body_w - vis)
    elif vis > body_w:
        text = art.pad_vis(art.strip_ansi(text), body_w)
    return "│ " + text + " │"


def chrome_pack(
    tw: int,
    th: int,
    title: str,
    chat_lines: list[str],
    prompt_lines: list[str],
    status: str,
    band: list[str] | None = None,
    band_title: str = "plan",
) -> list[str]:
    """One outer frame. Every line vis_len == tw. Nested prompt/runes boxes stay out."""
    import fae_termart as art

    top = art.box("", title=title, width=tw, cap=None).splitlines()[0]
    bot = art.box("", width=tw, cap=None).splitlines()[-1]
    prompt_lines = list(prompt_lines) or [""]
    band = list(band) if band else []
    # top, bot, status, 2 hrules around prompt, optional (hrule + band)
    overhead = 5 + len(prompt_lines) + (1 + len(band) if band else 0)
    chat_area = max(1, th - overhead)
    blank = _wall_row("", tw, art)
    chat_lines = list(chat_lines)[:chat_area]
    if len(chat_lines) < chat_area:
        chat_lines = [blank] * (chat_area - len(chat_lines)) + chat_lines
    out = [top]
    out.extend(chat_lines)
    if band:
        out.append(art.hrule(tw, band_title))
        out.extend(_wall_row(ln, tw, art) for ln in band)
    out.append(art.hrule(tw))
    out.extend(_wall_row(ln, tw, art) for ln in prompt_lines)
    out.append(art.hrule(tw))
    out.append(_wall_row(status, tw, art))
    out.append(bot)
    return out


def chat_ui(verbose: bool = False, resume_id: str | None = None) -> int:
    import fae_termart as art
    from fae_termart import Palette as P

    os.environ["PIXIE_UNICODE"] = "1"
    os.environ["LANG"] = "en_US.UTF-8"

    fd = art.tui_open_tty()
    if fd is None:
        print("Error: pixie chat requires an interactive terminal", file=sys.stderr)
        return 1
    art.tui_begin(fd, "pixie")

    buf = ""
    cur = 0
    help_on = False
    menu = {"kind": None, "idx": 0}
    busy = False
    rune_idx = 0
    cancel = {"flag": False}
    pending = {"text": "", "full": "", "live": False, "done": True,
               "cancelled": False, "err": None, "tool": None, "round": (0, 6)}
    view = {"off": 0}
    waking = {"flag": False}
    enter_pending = False
    confirm = _Confirm()
    mind.seed_memory()
    if resume_id:
        chat, last_rune = mind.chat_from_session(resume_id)
        session_id = resume_id
        view["off"] = 10**9
        for i, r in enumerate(_RUNES):
            if r["key"] == last_rune:
                rune_idx = i
                break
    else:
        chat = []
        session_id = time.strftime("%Y%m%d-%H%M%S")

    if not llm_up(verbose):
        waking["flag"] = True

        def _wake() -> None:
            ensure_llm_up()
            waking["flag"] = False

        threading.Thread(target=_wake, daemon=True).start()

    def tool_body(fname: str, fargs: dict, result: dict) -> str:
        lines = [f"Routing: {fname} -> {json.dumps(fargs)}"]
        if isinstance(result, dict):
            if result.get("error"):
                lines.append(f"error: {str(result['error'])[:180]}")
            elif result.get("stdout"):
                lines.append(str(result["stdout"])[:260])
            elif result.get("written"):
                lines.append(f"wrote {result.get('bytes', 0)} bytes to {result.get('path')}")
            elif "wrote" in result:
                if result.get("wrote"):
                    lines.append(f"remembered in {result.get('path')}")
                else:
                    lines.append(str(result.get("note") or "already known"))
            elif result.get("count") is not None:
                lines.append(f"{result.get('count', 0)} results for {result.get('query', '')}")
        else:
            lines.append(str(result)[:180])
        return "\n".join(lines)

    def send(text: str) -> None:
        nonlocal busy
        rune = _RUNES[rune_idx]
        chat.append(("user", text))
        mind.append_session(session_id, "user", text, rune=rune["key"])
        busy = True
        cancel["flag"] = False
        pending.update(text="", full="", live=False, done=False,
                       cancelled=False, err=None, tool=None)
        t0 = time.time()
        threading.Thread(target=worker, args=(text, rune, t0), daemon=True).start()

    def worker(text: str, rune: dict, t0: float) -> None:
        msgs = chat_messages(chat, rune, session_id=session_id)
        rounds = 0
        round_cap = int(rune.get("rounds") or 6)
        pending["round"] = (0, round_cap)
        first = ""
        last_call: tuple = (None, None)
        repeat = 0

        def show(chunk: str) -> None:
            nonlocal first
            first += chunk
            if pending["live"]:
                pending["text"] += chunk
                pending["full"] += chunk
            elif first.lstrip().startswith("{"):
                pass  # hidden tool intent
            else:
                pending["live"] = True
                pending["text"] = first
                pending["full"] = first

        def fail(msg: str) -> None:
            pending["err"] = msg

        ctx_retry = False
        tools_ok = True
        nudged = False
        deep_nudged = False
        spec_nudged = False
        fetch_count = 0
        empty_tool = False
        while True:
            first = ""
            pending["live"] = False
            stream_chat(msgs, show, cancel, fail,
                        tools=(_rune_tools(rune) if tools_ok else None))
            first = mind.strip_think(first)
            pending["full"] = mind.strip_think(pending.get("full") or "")
            pending["text"] = mind.strip_think(pending.get("text") or "")
            if cancel["flag"]:
                pending["cancelled"] = True
                pending["done"] = True
                return
            if pending["err"] and tools_ok and "400" in pending["err"].lower():
                tools_ok = False
                pending["err"] = None
                pending["full"] = ""
                pending["text"] = ""
                continue
            if (pending["err"] and not ctx_retry and len(msgs) > 2
                    and any(k in pending["err"].lower() for k in ("400", "context", "too long"))):
                # Context overflow: drop the oldest history and retry once.
                ctx_retry = True
                pending["err"] = None
                pending["full"] = ""
                pending["text"] = ""
                _drop_oldest(msgs)
                continue

            intent = None
            if not pending["live"]:
                try:
                    intent = json.loads(first.lstrip())
                except (json.JSONDecodeError, ValueError):
                    intent = None
            tool_calls = []
            if intent and isinstance(intent, dict) and "name" in intent:
                tool_calls.append(intent)
            else:
                for obj, start, end in extract_all_tool_calls(first):
                    tool_calls.append(obj)
                    if pending["live"]:
                        stripped = first[:start] + first[end:]
                        pending["text"] = stripped
                        pending["full"] = stripped
                        first = stripped
            if (not tool_calls and rune.get("key") == "deep" and fetch_count == 0
                    and not deep_nudged and first.strip()):
                deep_nudged = True
                msgs.append({"role": "assistant", "content": first})
                msgs.append({"role": "user", "content": (
                    "That answer has no fetched page. Call fetch_web_page on a URL "
                    "from the search results, then answer with Sources."
                )})
                pending["full"] = ""
                pending["text"] = ""
                pending["live"] = False
                continue
            if (not tool_calls and empty_tool and fetch_count == 0
                    and mind.looks_like_invented_specs(first)
                    and not spec_nudged and first.strip()):
                spec_nudged = True
                msgs.append({"role": "assistant", "content": first})
                msgs.append({"role": "user", "content": (
                    "No source for those numbers. Search the web or say you do not know. "
                    "Do not invent sizes or torque."
                )})
                pending["full"] = ""
                pending["text"] = ""
                pending["live"] = False
                continue
            if (not tool_calls and not nudged and first.strip()
                    and mind.looks_like_narrated_tools(first)):
                nudged = True
                msgs.append({"role": "assistant", "content": first})
                msgs.append({"role": "user", "content": (
                    "That was narration, not a tool call. If you need a tool, reply with "
                    "EXACTLY one JSON object {\"name\": \"...\", \"arguments\": {...}} "
                    "and nothing else. If you are done, answer conversationally."
                )})
                pending["full"] = ""
                pending["text"] = ""
                pending["live"] = False
                continue
            if tool_calls and rounds < round_cap:
                results = []
                for obj in tool_calls[:4]:
                    fname = obj.get("name", "")
                    fargs = obj.get("arguments", {})
                    if last_call == (fname, json.dumps(fargs)):
                        repeat += 1
                    else:
                        repeat = 0
                    last_call = (fname, json.dumps(fargs))
                    if repeat >= 3:
                        break
                    t1 = time.time()
                    pending["round"] = (rounds + 1, round_cap)
                    pending["tool"] = (fname, fargs, None, 0.0, t1)
                    result = run_tool(fname, fargs, confirm=confirm.ask, session_id=session_id)
                    if fname == "fetch_web_page" and isinstance(result, dict) and not result.get("error"):
                        fetch_count += 1
                    if mind.tool_was_empty(result):
                        empty_tool = True
                    if fname == "write_plan" and isinstance(result, dict) and result.get("wrote"):
                        menu["kind"] = "plan"
                        menu["idx"] = 0
                    _log_tool(fname, fargs, result)
                    mind.append_session(
                        session_id, "tool", rune=rune.get("key", ""),
                        tool=fname, args=fargs, result=result, raw=first,
                    )
                    pending["tool"] = None
                    if cancel["flag"]:
                        pending["cancelled"] = True
                        pending["done"] = True
                        return
                    chat.append(("tool", f"Calling tools ─ ✦ thought for {time.time() - t1:.2f}s",
                                 tool_body(fname, fargs, result)))
                    results.append({"tool": fname, "arguments": fargs, "result": result})
                if results:
                    msgs.append({"role": "assistant", "content": first})
                    msgs.append({"role": "tool", "content": tool_payload(results)})
                    rounds += 1
                    continue

            if not pending["live"]:
                pending["live"] = True
                pending["text"] = first
                pending["full"] = first
            break

        if cancel["flag"]:
            pending["cancelled"] = True
        elif pending["full"].strip():
            chat.append(("assistant", pending["full"].strip(),
                         f"Thought for {time.time() - t0:.2f}s"))
            mind.append_session(
                session_id, "assistant", pending["full"].strip(),
                rune=rune.get("key", ""),
            )
        elif pending["err"]:
            err = f"(✦ pixie lost the connection: {pending['err']})"
            chat.append(("assistant", err))
            mind.append_session(session_id, "assistant", err, rune=rune.get("key", ""))
        pending["done"] = True

    def bubble_w_for(text: str, title: str, max_w: int) -> int:
        longest = max((art.vis_len(l) for l in (text.splitlines() or [""])), default=0)
        w = max(24, longest + 4)
        w = max(w, art.vis_len(title) + 6)
        return min(max_w, w)

    def compose() -> str:
        tw = art.term_width(cap=None)
        th = art.term_height()
        rune = _RUNES[rune_idx]
        max_bw = min(tw - 8, (tw * 4) // 5)
        gap = tw - 4
        sections: list[list[str]] = []

        def push(blines: list[str], align: str) -> None:
            sec: list[str] = []
            for ln in blines:
                w = art.vis_len(ln)
                if align == "left":
                    sec.append("│ " + ln + " " * max(0, gap - w) + " │")
                elif align == "right":
                    sec.append("│ " + " " * max(0, gap - w) + ln + " │")
                else:
                    lpad = max(0, (gap - w) // 2)
                    sec.append("│ " + " " * lpad + ln + " " * max(0, gap - lpad - w) + " │")
            sections.append(sec)

        for entry in chat:
            if entry[0] == "user":
                _, text = entry
                push(art.box(text, title="you", accent=P.BLUSH,
                             width=bubble_w_for(text, "you", max_bw),
                             cap=None).splitlines(), "left")
            elif entry[0] == "assistant":
                text = entry[1]
                ts = entry[2] if len(entry) > 2 else time.strftime("%H:%M")
                push(art.box(text, title=f"Pixie ✦ {ts}", accent=P.BLUSH,
                             width=bubble_w_for(text, f"Pixie ✦ {ts}", max_bw),
                             cap=None).splitlines(), "right")
            else:
                _, title, body = entry
                push(art.box(body, title=title, accent=P.PINK_DIM,
                             width=min(max_bw, tw - 8), cap=None).splitlines(), "center")

        inner = max(8, tw - 4)
        if confirm.pending is not None:
            cfname, cfargs = confirm.pending
            prompt_lines = art.wrap_plain(
                f"approve {cfname}? {json.dumps(cfargs, ensure_ascii=False)}  [y/N]",
                inner,
            )[:8]
        elif waking["flag"]:
            prompt_lines = ["✦ waking the menagerie brain…"]
        elif busy:
            rc = pending.get("round") or (0, 6)
            phase = f"round {rc[0]}/{rc[1]} · thinking…"
            if pending["tool"]:
                phase = (f"round {rc[0]}/{rc[1]} · {pending['tool'][0]} "
                         f"({time.time() - pending['tool'][4]:.1f}s)")
            prompt_lines = ["✦ " + phase]
        elif not buf:
            prompt_lines = [f"✦ {rune['desc']} · ↑↓ · ?"]
        else:
            prefix = "✦ "
            full = prefix + buf
            pos = min(len(prefix) + max(0, min(cur, len(buf))), len(full))
            spans: list[tuple[int, str]] = []
            i = 0
            while i < len(full) or not spans:
                start = i
                take = ""
                while i < len(full):
                    ch = full[i]
                    if ch == "\n":
                        i += 1
                        break
                    if art.vis_len(take + ch) > inner:
                        break
                    take += ch
                    i += 1
                spans.append((start, take))
                if i >= len(full):
                    break
            painted = []
            for start, ln in spans:
                end = start + len(ln)
                if start <= pos <= end:
                    col = pos - start
                    if col >= len(ln):
                        painted.append(ln + "\033[7m \033[27m")
                    else:
                        painted.append(ln[:col] + "\033[7m" + ln[col] + "\033[27m" + ln[col + 1:])
                else:
                    painted.append(ln)
            prompt_lines = painted[-8:]

        pills = []
        for i, r in enumerate(_RUNES):
            label = f"{i + 1} {r['name']}"
            if i == rune_idx:
                pills.append("[" + label + "]")
            else:
                pills.append(" " + label + " ")
        status = " ".join(pills) + "  · ?"

        band: list[str] = []
        if help_on or menu.get("kind") == "help":
            band = [
                "enter send · esc clear · q quit · 1–4 runes · tab cycle",
                "←→ · ctrl-a/e/w/u · paste · ↑↓ scroll",
                "Plan: after write_plan, y approve → Build · e stay · n drop",
            ]
        elif menu.get("kind") == "plan":
            card = mind.plan_summary(session_id, max_lines=4)
            if card:
                band.extend(card.splitlines())
            choices = mind.plan_menu_choices()
            idx = int(menu.get("idx") or 0) % len(choices)
            for i, (key, label, _act) in enumerate(choices):
                mark = "▸ " if i == idx else "  "
                band.append(f"{mark}{key}  {label}")
        else:
            card = mind.plan_summary(session_id, max_lines=4)
            if card and rune.get("key") in ("plan", "build"):
                band.extend(card.splitlines())

        all_lines: list[str] = []
        for sec in sections:
            all_lines.extend(sec)
        prompt_n = len(prompt_lines)
        band_n = len(band)
        overhead = 5 + prompt_n + (1 + band_n if band else 0)
        chat_area = max(1, th - overhead)
        max_off = max(0, len(all_lines) - chat_area)
        if view["off"] > max_off:
            view["off"] = max_off
        sliced = all_lines[view["off"] : view["off"] + chat_area]
        pack = chrome_pack(
            tw, th,
            title=f"Pixie ✦ {rune['name']} · {session_id}",
            chat_lines=sliced,
            prompt_lines=prompt_lines,
            status=status,
            band=band or None,
            band_title=("keys" if (help_on or menu.get("kind") == "help") else "plan"),
        )
        return "\n".join(pack)

    try:
        while True:
            frame = compose()
            try:
                art.paint_frame(fd, frame)
            except OSError:
                art.tty_write(fd, art.clear_screen() + frame + "\n")

            ev = art.tui_read_event(fd, timeout=0.05)
            if isinstance(ev, art.MouseEvent):
                if ev.action == "wheel":
                    if ev.button == 64:
                        view["off"] = max(0, view["off"] - 3)
                    elif ev.button == 65:
                        view["off"] += 3
                continue
            if isinstance(ev, art.PasteEvent):
                ins = ev.text
                buf = buf[:cur] + ins + buf[cur:]
                cur += len(ins)
                continue
            key = ev if isinstance(ev, str) else ""
            if confirm.pending is not None:
                if key in ("y", "Y", "enter"):
                    confirm.respond(True)
                elif key in ("n", "N", "esc", "ctrl-c"):
                    confirm.respond(False)
                continue
            if menu.get("kind") == "plan" and not buf:
                choices = mind.plan_menu_choices()
                nch = len(choices)
                if key in ("esc",):
                    menu["kind"] = None
                    continue
                if key in ("j", "down"):
                    menu["idx"] = (int(menu.get("idx") or 0) + 1) % nch
                    continue
                if key in ("k", "up"):
                    menu["idx"] = (int(menu.get("idx") or 0) - 1) % nch
                    continue
                act = None
                if key == "enter":
                    act = choices[int(menu.get("idx") or 0) % nch][2]
                else:
                    for shortcut, _label, name in choices:
                        if key == shortcut:
                            act = name
                            break
                if act == "approve":
                    menu["kind"] = None
                    for i, r in enumerate(_RUNES):
                        if r["key"] == "build":
                            rune_idx = i
                            break
                    send("Implement the active plan.")
                    buf = ""
                    cur = 0
                    continue
                if act == "edit":
                    menu["kind"] = None
                    continue
                if act == "drop":
                    mind.drop_plan(session_id)
                    menu["kind"] = None
                    continue
                if act:
                    continue
            if not waking["flag"] and enter_pending:
                enter_pending = False
                if buf.strip():
                    send(buf.strip())
                    buf = ""
                    cur = 0
                    continue
            if key == "up":
                view["off"] = max(0, view["off"] - 1)
                continue
            if key == "down":
                view["off"] += 1
                continue
            if key == "pgup":
                view["off"] = max(0, view["off"] - 5)
                continue
            if key == "pgdn":
                view["off"] += 5
                continue
            if busy and pending["done"]:
                busy = False
                cancel["flag"] = False
            if busy:
                if key in ("q", "Q"):
                    cancel["flag"] = True
                    break
                if key in ("esc", "ctrl-c") and not pending["done"]:
                    cancel["flag"] = True
                    continue
            if help_on and key in ("esc", "?", "q"):
                help_on = False
                continue
            if key in ("q", "Q", "ctrl-c", "ctrl-d") and not buf:
                break
            if key == "esc" and not buf:
                break
            if not buf and key in ("1", "2", "3", "4"):
                rune_idx = min(int(key) - 1, len(_RUNES) - 1)
            elif not buf and key == "?":
                help_on = True
            elif key == "ctrl-r" or key == "tab":
                rune_idx = (rune_idx + 1) % len(_RUNES)
            elif key == "esc":
                buf = ""
                cur = 0
            elif key == "ctrl-u":
                buf = ""
                cur = 0
            elif key == "ctrl-a" or key == "home":
                cur = 0
            elif key == "ctrl-e" or key == "end":
                cur = len(buf)
            elif key == "left":
                cur = max(0, cur - 1)
            elif key == "right":
                cur = min(len(buf), cur + 1)
            elif key == "ctrl-w":
                i = cur
                while i > 0 and buf[i - 1].isspace():
                    i -= 1
                while i > 0 and not buf[i - 1].isspace():
                    i -= 1
                buf = buf[:i] + buf[cur:]
                cur = i
            elif key == "enter":
                if waking["flag"]:
                    enter_pending = True
                elif buf.strip():
                    send(buf.strip())
                    buf = ""
                    cur = 0
            elif key == "backspace":
                if cur:
                    buf = buf[:cur - 1] + buf[cur:]
                    cur -= 1
            elif key == "delete":
                buf = buf[:cur] + buf[cur + 1:]
            elif key == "space":
                buf = buf[:cur] + " " + buf[cur:]
                cur += 1
            elif key and len(key) == 1 and key.isprintable():
                buf = buf[:cur] + key + buf[cur:]
                cur += 1
    finally:
        art.tui_cleanup()
        # Keep the server warm on quit — menagerie-idle frees RAM after 300s
        # anyway, and killing it forced a full 2.5 GB reload every session.
        # Set PIXIE_STOP_LLM_ON_EXIT=1 to restore stop-on-quit.
        if os.environ.get("PIXIE_STOP_LLM_ON_EXIT"):
            unload_qwen()
    return 0

def _print_chats() -> int:
    print(mind.format_chat_list())
    return 0


def _print_chat(sid: str | None) -> int:
    name = sid or mind.latest_session_id()
    if not name:
        print("pixie: no chats stored yet", file=sys.stderr)
        return 1
    print(mind.format_chat(name))
    return 0


def main() -> int:
    args = sys.argv[1:]
    verbose = False
    if "-v" in args:
        verbose = True
        args.remove("-v")
    if "--verbose" in args:
        verbose = True
        args.remove("--verbose")
    if "--chats" in args:
        return _print_chats()
    if "--chat" in args:
        i = args.index("--chat")
        sid = args[i + 1] if i + 1 < len(args) and not args[i + 1].startswith("-") else None
        return _print_chat(sid)
    if "--resume" in args:
        i = args.index("--resume")
        sid = args[i + 1] if i + 1 < len(args) and not args[i + 1].startswith("-") else None
        name = mind.resolve_session_id(sid)
        if not name:
            msg = f"pixie: no chat named {sid}" if sid else "pixie: no chats stored yet"
            print(msg, file=sys.stderr)
            return 1
        return chat_ui(verbose, resume_id=name)
        
    if not args:
        return chat_ui(verbose)

    user_input = " ".join(args)
    
    start_time = time.time()
    response = ask_pixie(user_input, verbose=verbose)
    total_elapsed_time = time.time() - start_time

    os.environ["PIXIE_UNICODE"] = "1"
    os.environ["LANG"] = "en_US.UTF-8"

    try:
        home_bin = os.path.join(os.path.expanduser("~"), "bin")
        if home_bin not in sys.path:
            sys.path.insert(0, home_bin)
            
        import fae_termart as art
        from fae_termart import Palette as P

        clean_response = response.strip()

        fit = max(40, min(76, art.term_width() - 1))
        print(art.box(
            clean_response,
            title=f"Pixie ─────── ✦ Thought for {total_elapsed_time:.2f}s",
            accent=P.BLUSH,
            body_style=(P.SILVER,),
            width=fit
        ))
    except Exception as e:
        if verbose:
            print(f"\033[91mLayout Engine Exception: {e}\033[0m", file=sys.stderr)
        print(response)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())