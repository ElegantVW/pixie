IMP_URL = os.environ.get("PIXIE_LLM_URL", "http://127.0.0.1:8082").rstrip("/")
KUR_URL = os.environ.get("KUR_LLM_URL", "http://127.0.0.1:8081").rstrip("/")


def llm_url_allowed(url: str) -> bool:
    """Loopback-only LLM endpoints unless IMP_ALLOW_REMOTE=1."""
    if os.environ.get("IMP_ALLOW_REMOTE", "").strip().lower() in (
        "1", "true", "yes", "on",
    ):
        return True
    try:
        from urllib.parse import urlparse
        host = (urlparse(url).hostname or "").lower()
    except Exception:
        return False
    return host in ("127.0.0.1", "localhost", "::1")


def require_local_llm(url: str) -> None:
    if not llm_url_allowed(url):
        raise RuntimeError(
            f"imp refuses non-loopback LLM at {url!r} "
            "(set IMP_ALLOW_REMOTE=1 to allow remote models)"
        )
IMP_ALIAS = os.environ.get("IMP_LLM_ALIAS", "imp")
KUR_ALIAS = os.environ.get("KUR_LLM_ALIAS", "kur")
MAX_TOKENS = int(os.environ.get("PIXIE_MAX_TOKENS", "3072"))
GEN_TIMEOUT = float(os.environ.get("IMP_TIMEOUT", "240"))
COMMENT_TIMEOUT = float(os.environ.get("IMP_COMMENT_TIMEOUT", "15"))

ART_DIR = Path(os.environ.get("PIXIE_ART_DIR", str(Path.home() / "pixie_art")))
GALLERY_PATH = Path(
    os.environ.get("PIXIE_IMP_GALLERY", str(Path.home() / ".cache" / "pixie" / "imp" / "gallery.json"))
)

